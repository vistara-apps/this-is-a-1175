# VidSynth Automator Environment Variables
# Copy this file to .env and fill in your actual API keys

# Runway AI API Key for video generation
VITE_RUNWAY_API_KEY=your_runway_api_key_here

# OpenAI API Key for AI insights and content generation
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Stripe API Keys for payment processing
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Pinata API Keys for IPFS file storage
VITE_PINATA_API_KEY=your_pinata_api_key_here
VITE_PINATA_SECRET_KEY=your_pinata_secret_key_here

# Optional: Custom API endpoints (use defaults if not specified)
# VITE_RUNWAY_API_URL=https://api.runwayml.com/v1
# VITE_OPENAI_API_URL=https://api.openai.com/v1
# VITE_STRIPE_API_URL=https://api.stripe.com/v1
# VITE_PINATA_API_URL=https://api.pinata.cloud

# Development settings
NODE_ENV=development
